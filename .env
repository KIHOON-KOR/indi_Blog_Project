# [.env]

# Django 시크릿 키 (보안상 임의의 문자로 변경하는 것이 좋습니다)
SECRET_KEY=django-insecure-change-me-for-production-blog-key

# 디버그 모드 (개발 중에는 True)
DEBUG=True

# 데이터베이스 설정 (블로그 프로젝트에 맞게 이름 변경)
POSTGRES_DB=blog_db_dev           # [변경] DB 이름
POSTGRES_USER=blog_user           # [변경] DB 사용자 ID
POSTGRES_PASSWORD=blog_password   # [변경] DB 비밀번호
POSTGRES_PORT=5432

# [주의] Docker Compose 내부에서는 서비스 이름('db' 혹은 컨테이너명)을 써야 합니다.
# 로컬에서 테스트할 때는 'localhost'를 쓰지만, 여기서는 도커 기준으로 설정합니다.
POSTGRES_HOST=blog_db

# Redis 설정 (나중에 사용 시 주석 해제)
# USE_REDIS=True
# REDIS_URL=redis://blog_redis:6379/0